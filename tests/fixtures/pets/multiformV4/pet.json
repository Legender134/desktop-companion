      "mirrorOf": "animalMoveRight",
      "frameCount": 2,
      "frameMs": 90,
      "loop": true,
      "autoplayWeight": 10,
      "layers": [
        {
          "atlas": "character",
          "row": 10,
          "startColumn": 0,
          "anchorX": 96,
          "anchorY": 208,
          "hitTest": true
        }
      ]
    },
    "animalResident": {
      "label": "小动物几何滚动",
      "role": "interaction",
      "frameCount": 2,
      "frameMs": 110,
      "showInMenu": false,
      "layers": [
        {
          "atlas": "character",
          "row": 11,
          "startColumn": 0,
          "anchorX": 96,
          "anchorY": 208,
          "hitTest": true
        }
      ]
    }
  },
  "forms": {
    "defaultHuman": {
      "label": "默认几何人形",
      "idleAction": "humanIdle",
      "moveRightAction": "humanMoveRight",
      "moveLeftAction": "humanMoveLeft",
      "gazeAction": "humanGaze",
      "representativeAction": "humanIdle",
      "interactionActions": ["wideSpell", "transformEnter"]
    },
    "smallAnimal": {
      "label": "几何小动物",
      "idleAction": "animalIdle",
      "moveRightAction": "animalMoveRight",
      "moveLeftAction": "animalMoveLeft",
      "representativeAction": "animalIdle",
      "interactionActions": ["animalResident"]
    }
  },
  "transformations": {
    "becomeAnimal": {
      "label": "变成几何小动物",
      "fromForm": "defaultHuman",
      "toForm": "smallAnimal",
      "enterAction": "transformEnter",
      "residentActions": [
        {
          "action": "animalResident",
          "weight": 100
        }
      ],
      "exitAction": "transformExit",
      "minDurationMs": 200,
      "maxDurationMs": 200,
      "showInMenu": true,
      "autoplay": {
        "bucket": "shapeEvents",
        "weight": 3,
        "minDelayMs": 100,
        "maxDelayMs": 100,
        "cooldownGroups": ["sharedShape"]
      }
    }
  },
  "sequences": {
    "shapeBurst": {
      "label": "几何形态连段",
      "showInMenu": true,
      "steps": [
        {
          "action": "wideSpell",
          "repeatCount": 2,
          "holdMs": 125,
          "formAfter": "smallAnimal",
          "safeStopAfter": false
        },
        {
          "action": "animalResident",
          "repeatCount": 1,
          "holdMs": 0,
          "formAfter": "defaultHuman",
          "safeStopAfter": true
        }
      ],
      "autoplay": {
        "bucket": "shapeEvents",
        "weight": 1,
        "minDelayMs": 100,
        "maxDelayMs": 100,
        "cooldownGroups": ["sharedShape"]
      }
    }
  }
}
