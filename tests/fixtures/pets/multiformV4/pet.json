          "row": 2,
          "startColumn": 0,
          "anchorX": 96,
          "anchorY": 208,
          "hitTest": true
        }
      ]
    },
    "wideSpell": {
      "label": "宽幅几何波",
      "role": "interaction",
      "frameCount": 3,
      "frameMs": 80,
      "showInMenu": true,
      "includeInShowcase": true,
      "autoplayWeight": 0,
      "layers": [
        {
          "atlas": "effects",
          "row": 0,
